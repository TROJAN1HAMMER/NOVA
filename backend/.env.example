# ============================
# KAVACH Environment Variables
# ============================
# Copy this file to `.env` and fill in real values before running anything
# beyond local development. Every setting below has a working default in
# `app/config.py` — this file exists so nothing is a surprise, not because
# all of it is required.

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-32chars-min
DEBUG=false
UPLOAD_DIR=uploads
REPORTS_DIR=reports
DATA_DIR=data

# Database (SQLAlchemy 2 async engine + Alembic)
DATABASE_URL=postgresql+asyncpg://kavach:kavach_secret@localhost:5432/kavach_db
DATABASE_ECHO=false

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# JWT Authentication
JWT_SECRET_KEY=change-me-jwt-32chars-minimum-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------------------------
# Knowledge Base (RAG — app/services/knowledge_base/). Local embedding
# model, no API key required; defaults match what the Dockerfile
# pre-downloads, so these normally never need to be set.
# ----------------------------------------------------------------------------
KNOWLEDGE_BASE_DIR=data/knowledge_base
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KNOWLEDGE_EMBEDDING_DIM=384
KNOWLEDGE_EMBEDDING_CACHE_DIR=data/fastembed_cache
KNOWLEDGE_CHUNK_SIZE_TOKENS=350
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=50
KNOWLEDGE_MAX_UPLOAD_MB=25
KNOWLEDGE_SEARCH_DEFAULT_TOP_K=5

# ----------------------------------------------------------------------------
# AI Assistant (RAG — app/services/assistant/). Reranker is local too, no
# API key required. The LLM answer itself still goes through the AI
# provider gateway below — with none configured, the assistant falls back
# to showing the retrieved excerpts directly rather than fabricating a
# generated answer.
# ----------------------------------------------------------------------------
ASSISTANT_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
ASSISTANT_RERANK_CACHE_DIR=data/rerank_cache
ASSISTANT_RETRIEVAL_CANDIDATES=20
ASSISTANT_TOP_K=5
ASSISTANT_MIN_CONFIDENCE=0.5
ASSISTANT_MAX_HISTORY_TURNS=6
ASSISTANT_MAX_TOKENS=1024
ASSISTANT_TEMPERATURE=0.2

# ----------------------------------------------------------------------------
# AI provider gateway (app/services/ai/gateway.py). Every provider below is
# optional — unconfigured ones are skipped, not attempted and failed. With
# NOTHING configured at all, automated finding explanations fall back to a
# rule-based template and RAG features report "insufficient information"
# rather than ever hallucinating.
#
# AI_MODE: "hybrid" (default, local first then cloud) | "cloud" | "local"
# AI_PROVIDER_PRIORITY: "auto" (default, derived from AI_MODE) or an explicit
#   comma-separated override, e.g. "vllm,ollama,claude"
# ----------------------------------------------------------------------------
AI_MODE=hybrid
AI_PROVIDER_PRIORITY=auto
AI_CACHE_TTL_SECONDS=86400

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Local/self-hosted — no API key, just a reachable endpoint. Known-good
# tags: Ollama "llama3" | "mistral" | "phi3" | "mixtral"; vLLM any
# OpenAI-compatible HF repo, e.g. "mistralai/Mistral-7B-Instruct-v0.3".
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=

# NVD (National Vulnerability Database) — unauthenticated requests are
# rate-limited to 5/30s; an API key raises that to 50/30s.
NVD_API_KEY=

# ----------------------------------------------------------------------------
# Report storage (app/services/reports/storage.py). "local" (default) keeps
# reports on the worker's own disk. "s3" uploads to an S3-compatible bucket
# (real AWS S3, or MinIO — MinIO speaks the same API, point S3_ENDPOINT_URL
# at it) and serves downloads via short-lived presigned URLs.
# ----------------------------------------------------------------------------
REPORT_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=kavach-reports
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRY_SECONDS=3600

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ----------------------------------------------------------------------------
# SSO — OAuth2/OIDC (app/auth/sso/oauth2_provider.py). A generic
# authorization-code-flow client that works against any standards-compliant
# IdP (Okta, Auth0, Azure AD, Google, Keycloak, ...). Left with a blank
# client_id, /auth/sso/oauth2/* routes respond 503 rather than attempting a
# flow with empty credentials.
# ----------------------------------------------------------------------------
OAUTH2_ENABLED=false
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_AUTHORIZE_URL=
OAUTH2_TOKEN_URL=
OAUTH2_USERINFO_URL=
OAUTH2_REDIRECT_URI=
OAUTH2_SCOPE=openid email profile

# ----------------------------------------------------------------------------
# SSO — LDAP (app/auth/sso/ldap_provider.py). Real search+bind
# authentication via `ldap3`.
# ----------------------------------------------------------------------------
LDAP_ENABLED=false
LDAP_SERVER_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
LDAP_USER_SEARCH_FILTER=(uid={username})
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_FULL_NAME_ATTRIBUTE=cn
LDAP_USE_SSL=false

# ----------------------------------------------------------------------------
# SSO — SAML 2.0 (app/auth/sso/saml_provider.py). The config surface,
# routes, and interface are real, but signature/assertion validation is not
# implemented yet — it needs a SAML XML toolkit with native xmlsec bindings,
# deliberately not added as a dependency. /auth/sso/saml/* routes respond
# 503 regardless of these settings until that lands.
# ----------------------------------------------------------------------------
SAML_ENABLED=false
SAML_IDP_METADATA_URL=
SAML_IDP_ENTITY_ID=
SAML_SP_ENTITY_ID=kavach
SAML_ACS_URL=

# Audit log — bounds how far back GET /auth/audit-log can query without an
# explicit override.
AUDIT_LOG_DEFAULT_LOOKBACK_DAYS=90

# ----------------------------------------------------------------------------
# Outbound notifications (app/services/notifications/) — fired on scan
# completion/failure and stalled-worker detection. Every channel below is
# independently optional; leaving one blank just skips that channel.
# ----------------------------------------------------------------------------
NOTIFICATIONS_ENABLED=false
NOTIFY_MIN_SEVERITY=CRITICAL

SLACK_WEBHOOK_URL=

EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=kavach@example.com
EMAIL_TO_ADDRESSES=

WEBHOOK_URL=
WEBHOOK_SECRET=

# Inbound GitHub webhook (app/api/v1/endpoints/webhooks.py) — set this to
# the same secret configured on the GitHub repo/org's webhook settings
# page. Blank means the endpoint refuses every delivery with 503.
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SCAN_ALL_BRANCHES=true

# Archive sweep (app/tasks/archive_tasks.py, nightly) — how long a terminal
# scan job's report *files* are kept before being reclaimed. The
# scan/finding/BRS/compliance database history is never deleted.
ARCHIVE_AFTER_DAYS=90
