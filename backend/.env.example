# ============================
# KAVACH Environment Variables
# ============================
# Copy this file to `.env` and fill in real values before running anything
# beyond local development.

# ============================================================================
# REQUIRED LOCAL VARIABLES
# ============================================================================

# Application
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-32chars-min
DEBUG=false
UPLOAD_DIR=uploads
REPORTS_DIR=reports
DATA_DIR=data

# Database (SQLAlchemy 2 async engine + Alembic)
DATABASE_URL=postgresql+asyncpg://kavach:kavach_secret@localhost:5432/kavach_db
DATABASE_ECHO=false

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# JWT Authentication
JWT_SECRET_KEY=change-me-jwt-32chars-minimum-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Knowledge Base (Local embedding model, no API key required)
KNOWLEDGE_BASE_DIR=data/knowledge_base
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KNOWLEDGE_EMBEDDING_DIM=384
KNOWLEDGE_EMBEDDING_CACHE_DIR=data/fastembed_cache
KNOWLEDGE_CHUNK_SIZE_TOKENS=350
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=50
KNOWLEDGE_MAX_UPLOAD_MB=25
KNOWLEDGE_SEARCH_DEFAULT_TOP_K=5

# AI Assistant Parameters
ASSISTANT_RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
ASSISTANT_RERANK_CACHE_DIR=data/rerank_cache
ASSISTANT_RETRIEVAL_CANDIDATES=20
ASSISTANT_TOP_K=5
ASSISTANT_MIN_CONFIDENCE=0.5
ASSISTANT_MAX_HISTORY_TURNS=6
ASSISTANT_MAX_TOKENS=1024
ASSISTANT_TEMPERATURE=0.2

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Archive sweep (nightly)
ARCHIVE_AFTER_DAYS=90

# ============================================================================
# OPTIONAL EXTERNAL SERVICES (Not required for local execution)
# ============================================================================

# AI provider gateway (Hybrid mode prefers local first)
AI_MODE=local
AI_PROVIDER_PRIORITY=auto
AI_CACHE_TTL_SECONDS=86400

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local/self-hosted AI endpoints (e.g. Ollama, vLLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=

# NVD (National Vulnerability Database)
NVD_ENABLED=false
NVD_API_KEY=

# Exa Web Search (Fallback for AI Assistant)
EXA_ENABLED=false
EXA_API_KEY=

# Report storage backend (local is default)
REPORT_STORAGE_BACKEND=local
# Set REPORT_STORAGE_BACKEND=s3 to use the following optional AWS S3 / MinIO backend
S3_ENDPOINT_URL=
S3_BUCKET=kavach-reports
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_PATH_STYLE=true
S3_PRESIGNED_URL_EXPIRY_SECONDS=3600

# SSO — OAuth2/OIDC
OAUTH2_ENABLED=false
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_AUTHORIZE_URL=
OAUTH2_TOKEN_URL=
OAUTH2_USERINFO_URL=
OAUTH2_REDIRECT_URI=
OAUTH2_SCOPE=openid email profile

# SSO — LDAP
LDAP_ENABLED=false
LDAP_SERVER_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_SEARCH_BASE=
LDAP_USER_SEARCH_FILTER=(uid={username})
LDAP_EMAIL_ATTRIBUTE=mail
LDAP_FULL_NAME_ATTRIBUTE=cn
LDAP_USE_SSL=false

# SSO — SAML 2.0 (Not implemented)
SAML_ENABLED=false
SAML_IDP_METADATA_URL=
SAML_IDP_ENTITY_ID=
SAML_SP_ENTITY_ID=kavach
SAML_ACS_URL=

# Audit log
AUDIT_LOG_DEFAULT_LOOKBACK_DAYS=90

# Outbound notifications
NOTIFICATIONS_ENABLED=false
NOTIFY_MIN_SEVERITY=CRITICAL

SLACK_WEBHOOK_URL=

EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=kavach@example.com
EMAIL_TO_ADDRESSES=

WEBHOOK_URL=
WEBHOOK_SECRET=

# Inbound GitHub webhook
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SCAN_ALL_BRANCHES=true
